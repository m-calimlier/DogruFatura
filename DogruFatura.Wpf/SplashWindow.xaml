<Window x:Class="DogruFatura.Wpf.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/AppIcon.ico" Title="DoğruFatura"
        Width="460" Height="585" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#0B162B" FontFamily="Segoe UI"
        ShowInTaskbar="True" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Border Margin="18" CornerRadius="17" BorderThickness="1" BorderBrush="#9B804E">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1F2C44" Offset="0"/>
                    <GradientStop Color="#111F36" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Canvas IsHitTestVisible="False">
            <Ellipse Width="156" Height="156" Canvas.Left="285" Canvas.Top="48">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#20E8C778" Offset="0"/><GradientStop Color="#00E8C778" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="148" Height="148" Canvas.Left="18" Canvas.Top="386">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#1AE8C778" Offset="0"/><GradientStop Color="#00E8C778" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
            <Path Stroke="#8AD7AE61" Data="M360,115 H372 M366,109 V121 M76,409 H86 M81,404 V414"/>
        </Canvas>
        <StackPanel VerticalAlignment="Top" Margin="0,51,0,0">
            <Image Source="Assets/AppIcon_512.png" Width="70" Height="70"/>
            <TextBlock TextAlignment="Center" FontSize="32" FontWeight="Bold" Foreground="#F0F6FC" Margin="0,8,0,0">
                <Run Text="Doğru"/><Run Text="Fatura" Foreground="#E8C778"/>
            </TextBlock>
        </StackPanel>
        <Grid Width="136" Height="136" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Ellipse Margin="6" Fill="#091529" Stroke="#384C64" StrokeThickness="6"/>
            <Path x:Name="ProgressArc" Stroke="#D7AE61" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Ellipse x:Name="CompletedRing" Visibility="Collapsed" Margin="6" Stroke="#D7AE61" StrokeThickness="6"/>
            <TextBlock x:Name="PercentText" Text="%0" FontSize="34" FontWeight="Bold" Foreground="#E8C778" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <TextBlock x:Name="StageText" Text="Bileşenler hazırlanıyor..." VerticalAlignment="Center"
                   Margin="32,173,32,0" Foreground="#B9CDDF" FontSize="13" TextAlignment="Center" TextWrapping="Wrap"/>
        <Border VerticalAlignment="Bottom" Margin="39,0,39,32" Padding="12,12,12,10" CornerRadius="12"
                Background="#091529" BorderBrush="#A38751" BorderThickness="1">
            <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="4" Opacity=".35"/></Border.Effect>
            <StackPanel>
                <TextBlock Text="Created by" Foreground="#E8C778" FontSize="15" FontWeight="SemiBold" TextAlignment="Center"/>
                <TextBlock Text="Murat ÇALIMLER" FontSize="32" FontWeight="Bold" TextAlignment="Center" Margin="0,3,0,0">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFF2C6" Offset="0"/>
                            <GradientStop Color="#E8C778" Offset=".52"/>
                            <GradientStop Color="#C09950" Offset="1"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>
                <TextBlock x:Name="VersionText" Foreground="#B9CDDF" FontSize="11" TextAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
